global
    log stdout format raw local0
    maxconn 4096
    tune.ssl.default-dh-param 2048

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000
    timeout tunnel  1h
    option  forwardfor
    option  http-server-close

__WEB_AUTH_USERLIST__

__RATE_LIMIT_TABLE__

# Frontend - receives all incoming requests
frontend mcp_frontend
    bind *:__SERVER_PORT__ __BIND_PARAMS__ __FRONTEND_MAXCONN__
    __QUIC_BIND_LINE__

    # Define ACL for health check endpoint from localhost
    acl is_health_check path /healthz
    acl is_localhost src 127.0.0.1 ::1

    # Route ACLs
    # is_mcp_path matches the relocated MCP endpoint (/api/mcp). It is used only
    # by the auth rules — Basic-auth-exempt + API_KEY-enforced, same posture the
    # old /mcp route had — NOT for routing (/api/mcp flows to web_api_backend via
    # is_api_path). Must be a more specific prefix listed alongside is_api_path.
    acl is_mcp_path path_beg /api/mcp
    acl is_api_path path_beg /api

    # Mutating REST routes re-gated by API_KEY in the generated auth block (method-scoped
    # so GET /api/repos and GET /api/analyze/{job} stay open). The /api/* exemption
    # would otherwise leave POST /api/analyze + DELETE /api/repo unauthenticated.
    # Both use path_beg + method scoping. is_repo_path matching /api/repos too is
    # harmless: it's only referenced in the METH_DELETE deny rule, and there is no
    # DELETE /api/repos route, so the open GET /api/repos list is never affected.
    # normalize-uri (below) first canonicalizes // and dot-segments so these
    # prefixes can't be dodged via path-normalization mismatches with the backend.
    acl is_analyze_path path_beg /api/analyze
    acl is_repo_path path_beg /api/repo

    # Paths exempt from API key auth
    acl is_web_ui path /
    acl is_web_ui path_beg /assets

    # Define ACL that's always false (for CORS disabled scenario)
    acl always_false always_false

    # Canonicalize the request path BEFORE any path-based ACL/auth/routing decision
    # so HAProxy sees the same path the backend (Express, non-strict routing) will
    # resolve to. Without this, DELETE /api/repo/ , /api//repo , /api/repo/x/.. etc.
    # slip past the exact/prefix ACLs and reach the mutating handlers UNAUTHENTICATED.
    http-request normalize-uri path-merge-slashes
    http-request normalize-uri path-strip-dot
    http-request normalize-uri path-strip-dotdot

    # Local health endpoint answered directly by HAProxy, before IP/auth/rate
    # filters, so Docker's localhost healthcheck always succeeds regardless of
    # upstream readiness.
    http-request return status 200 content-type "text/plain" string "ok\n" if is_health_check is_localhost

    # IP access control (allowlist/blocklist)
    __IP_ACCESS_CHECK__

    # Extract Authorization header
    http-request set-var(txn.auth_header) req.hdr(Authorization)

    # Extract Origin header for CORS validation
    http-request set-var(txn.origin) req.hdr(Origin)

    __CORS_CHECK__

    # Handle CORS preflight (OPTIONS) requests BEFORE auth (browsers don't send credentials on preflight)
    http-request return status 204 hdr "Access-Control-Allow-Origin" "%[var(txn.origin)]" hdr "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS" hdr "Access-Control-Allow-Headers" "Authorization, Content-Type, X-Requested-With" hdr "Access-Control-Max-Age" "86400" if METH_OPTIONS __CORS_PREFLIGHT_CONDITION__

    # Web UI Basic auth (username/password login)
    __WEB_AUTH_CHECK__

    # Rate limiting and connection limiting
    __RATE_LIMIT_CHECK__

    # Skip API key check for health check endpoint (always unauthenticated)
    __API_KEY_CHECK__

    # Add CORS headers to all responses
    http-response set-header Access-Control-Allow-Origin "%[var(txn.origin)]" if __CORS_RESPONSE_CONDITION__
    http-response set-header Access-Control-Allow-Credentials "true" if __CORS_RESPONSE_CONDITION__

    # Security headers
    http-response set-header X-Content-Type-Options "nosniff"
    http-response set-header X-Frame-Options "DENY"
    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains" if { ssl_fc }

    # Route: API requests -> gitnexus serve (also mounts /api/mcp)
    use_backend web_api_backend if is_api_path

    # Route: Everything else -> static frontend
    default_backend web_static_backend

# Backend - GitNexus API server (gitnexus serve; also mounts /api/mcp)
backend web_api_backend
    balance roundrobin
    server gitnexus-api [::1]:__WEB_UI_PORT__

# Backend - Static frontend files (serve)
backend web_static_backend
    balance roundrobin
    server gitnexus-static 127.0.0.1:__WEB_UI_STATIC_PORT__
